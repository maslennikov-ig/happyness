{
  "name": "happyness-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.15.1",
    "npm": "^11.4.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
