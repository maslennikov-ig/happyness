// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Модель пользователя
model User {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String?
  password   String
  role       UserRole    @default(ENTREPRENEUR)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  projects   Project[]
  requests   Request[]
  contractor Contractor?
}

// Роли пользователей
enum UserRole {
  ADMIN
  ENTREPRENEUR
  CONTRACTOR
}

// Модель подрядчика
model Contractor {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  description String?
  services    String[]
  rating      Float     @default(0)
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  requests    Request[]
  projects    Project[]
}

// Модель проекта
model Project {
  id           String        @id @default(uuid())
  title        String
  description  String?
  status       ProjectStatus @default(PLANNING)
  budget       Float?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id])
  contractorId String?
  contractor   Contractor?   @relation(fields: [contractorId], references: [id])
  requests     Request[]
}

// Статусы проекта
enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Модель запроса
model Request {
  id           String        @id @default(uuid())
  title        String
  description  String
  budget       Float?
  deadline     DateTime?
  status       RequestStatus @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id])
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  contractorId String?
  contractor   Contractor?   @relation(fields: [contractorId], references: [id])
}

// Статусы запроса
enum RequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
