FROM node:22-alpine

# Установка рабочей директории
WORKDIR /app

# Установка глобальных зависимостей
RUN npm install -g npm@latest @nestjs/cli

# Установка дополнительных зависимостей для работы с базами данных
RUN apk add --no-cache python3 make g++ postgresql-client

# Копирование файлов package.json и package-lock.json
COPY package*.json ./

# Установка зависимостей
RUN npm ci

# Переустановка bcrypt, чтобы правильно скомпилировать нативные зависимости
RUN npm uninstall bcrypt && npm install bcrypt

# Копирование исходного кода
COPY . .

# Создаем директорию prisma, если она не существует
RUN mkdir -p prisma

# Генерация Prisma клиента только если схема существует
RUN if [ -f prisma/schema.prisma ]; then npx prisma generate; else echo "Prisma schema not found, skipping generation"; fi

# Экспорт порта для NestJS API
EXPOSE 4000

# Команда для запуска NestJS в режиме разработки (исправлено имя скрипта)
CMD ["npm", "run", "start:backend:dev"] 