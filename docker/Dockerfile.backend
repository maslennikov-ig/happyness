FROM node:22-alpine AS base

# Установка рабочей директории
WORKDIR /app

# Установка глобальных зависимостей только для разработки и сборки
RUN npm install -g npm@latest @nestjs/cli

# Этап установки зависимостей
FROM base AS deps
WORKDIR /app

# Установка дополнительных зависимостей для сборки нативных модулей (argon2) и миграций
RUN apk add --no-cache python3 make g++ postgresql-client

# Копирование только backend package.json и package-lock.json
COPY src/backend/package*.json ./

# Удаление node_modules на всякий случай (гарантия чистоты)
RUN rm -rf node_modules

# Установка зависимостей (только production)
ENV npm_config_legacy_peer_deps=true
RUN npm ci --omit=dev --omit=optional --ignore-scripts

# Установка argon2 для хеширования паролей
RUN npm install argon2

# Этап разработки
FROM base AS dev
WORKDIR /app

# Установка дополнительных зависимостей
RUN apk add --no-cache python3 make g++ postgresql-client

# Копирование node_modules из этапа установки зависимостей
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Копирование prisma схемы
COPY prisma ./prisma/

# Генерация Prisma клиента
RUN npx prisma generate

# Экспорт порта для NestJS API
EXPOSE 4000

# Команда для запуска NestJS в режиме разработки с горячей перезагрузкой
CMD ["npm", "run", "start:backend:dev"]

# Этап сборки
FROM base AS builder
WORKDIR /app

# Установка дополнительных зависимостей
RUN apk add --no-cache python3 make g++ postgresql-client

# Копирование node_modules из этапа установки зависимостей
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Копирование prisma схемы
COPY prisma ./prisma/

# Генерация Prisma клиента
RUN npx prisma generate

# Сборка приложения NestJS без тестов
RUN nest build --config ./tsconfig.build.json

# Производственный этап
FROM base AS prod
WORKDIR /app

ENV NODE_ENV production

# Установка только postgresql-client для работы приложения (без сборочных инструментов)
RUN apk add --no-cache postgresql-client

# Копирование только необходимых файлов из этапа сборки
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/prisma ./prisma

# Экспорт порта для NestJS API
EXPOSE 4000

# Команда для запуска NestJS в production режиме
USER node
CMD ["npm", "run", "start:backend:prod"]