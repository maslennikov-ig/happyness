FROM node:22-alpine AS base

# Установка рабочей директории
WORKDIR /app

# Установка глобальных зависимостей
RUN npm install -g npm@latest @nestjs/cli

# Этап установки зависимостей
FROM base AS deps
WORKDIR /app

# Установка дополнительных зависимостей для работы с базами данных
RUN apk add --no-cache python3 make g++ postgresql-client

# Копирование файлов package.json и package-lock.json
COPY package*.json ./

# Установка зависимостей (без devDependencies)
ENV npm_config_legacy_peer_deps=true
RUN npm ci --omit=dev || npm ci --omit=dev

# Установка argon2 для хеширования паролей
RUN npm install argon2

# Этап разработки
FROM base AS dev
WORKDIR /app

# Установка дополнительных зависимостей
RUN apk add --no-cache python3 make g++ postgresql-client

# Копирование node_modules из этапа установки зависимостей
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Копирование prisma схемы
COPY prisma ./prisma/

# Генерация Prisma клиента
RUN npx prisma generate

# Экспорт порта для NestJS API
EXPOSE 4000

# Команда для запуска NestJS в режиме разработки с горячей перезагрузкой
CMD ["npm", "run", "start:backend:dev"]

# Этап сборки
FROM base AS builder
WORKDIR /app

# Установка дополнительных зависимостей
RUN apk add --no-cache python3 make g++ postgresql-client

# Копирование node_modules из этапа установки зависимостей
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Копирование prisma схемы
COPY prisma ./prisma/

# Генерация Prisma клиента
RUN npx prisma generate

# Сборка приложения NestJS
RUN npm run build

# Производственный этап
FROM base AS prod
WORKDIR /app

ENV NODE_ENV production

# Установка необходимых зависимостей
RUN apk add --no-cache postgresql-client

# Копирование только необходимых файлов из этапа сборки
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/prisma ./prisma

# Экспорт порта для NestJS API
EXPOSE 4000

# Команда для запуска NestJS в production режиме
CMD ["npm", "run", "start:backend:prod"] 