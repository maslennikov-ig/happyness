{
  "name": "happyness",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.15.1",
    "npm": "^11.4.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev",
    "dev:backend": "nest start --watch",
    "build": "next build && nest build",
    "start": "next start",
    "start:backend": "nest start",
    "start:backend:dev": "nest start --watch",
    "start:backend:prod": "node dist/src/backend/main",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:frontend": "vitest run -c vitest.frontend.config.ts",
    "test:backend": "vitest run -c vitest.backend.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:auth": "vitest run \"src/backend/test/api/services/auth.service.spec.ts\" \"src/backend/test/api/services/password.service.spec.ts\" \"src/backend/test/api/services/token.service.spec.ts\" \"src/backend/test/api/guards/roles.guard.spec.ts\" \"src/backend/test/api/auth.controller.spec.ts\"",
    "test:auth:integration": "vitest run \"src/backend/test/api/auth.integration.spec.ts\"",
    "test:auth:all": "scripts/run-auth-tests.bat",
    "test:watch": "vitest",
    "test:mcp": "npx playwright test src/frontend/test/mcp-tests",
    "mcp:playwright": "npx @executeautomation/playwright-mcp-server",
    "docker:dev": "docker-compose up",
    "docker:dev:build": "docker-compose up --build",
    "docker:dev:down": "docker-compose down",
    "docker:dev:logs": "docker-compose logs -f",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "docker:prod:build": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "docker:db:reset": "npx prisma migrate reset --force",
    "docker:db:seed": "npx prisma db seed",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@nestjs/common": "^11.1.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-toast": "^1.2.13",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@types/js-cookie": "^3.0.6",
    "@types/zxcvbn": "^4.4.5",
    "argon2": "^0.43.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.6.1",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.25.3",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@executeautomation/playwright-mcp-server": "^1.0.5",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/react": "^16",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.15.18",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.1.4",
    "@types/react-dom": "19.1",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^9.7.0",
    "eslint-config-next": "^15.3.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "6.0.0-rc.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "prisma": "^6.7.0",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^3.1.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
